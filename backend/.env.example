# Copy to .env and adjust as needed.

APP_NAME="Issue Reporting & Intervention System"
ENVIRONMENT=development

# Host connection (uvicorn running outside Docker against the compose database).
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/intervention_db

# Used by the pytest suite; it is created automatically if missing.
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/intervention_test_db

# Set to true to log every SQL statement.
SQL_ECHO=false

# Signs the JWT access tokens. Generate your own: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-only-insecure-secret-change-me-before-deploying
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
